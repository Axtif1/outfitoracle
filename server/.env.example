# Server Port (Render sets this automatically)
PORT=5000
NODE_ENV=production

# MongoDB Connection String
MONGODB_URI=your_mongodb_connection_string

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Cloudinary Credentials (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key (Virtual Try-On AI)
GEMINI_API_KEY=your_gemini_api_key

# CORS Allowed Origins (Comma-separated, e.g. https://your-project.vercel.app,http://localhost:5173)
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173
